{
  "name": "scheme-js-4",
  "version": "1.0.0-beta",
  "type": "module",
  "description": "",
  "main": "main.js",
  "scripts": {
    "test": "node --expose-gc run_tests_node.js",
    "test:repl": "node tests/functional/repl_debug.mjs",
    "benchmark": "node benchmarks/run_benchmarks.js",
    "benchmark:save": "node benchmarks/save_baseline.js",
    "benchmark:compare": "node benchmarks/compare_baseline.js",
    "pretest": "npm run build",
    "prebuild": "node scripts/generate_bundled_libraries.js && node repl.js -I scripts/lib scripts/generate_compiled_libraries.scm && node repl.js -I scripts/lib scripts/generate_compiled_compiler.scm",
    "build": "rollup -c && cp web/gh-pages.html dist/index.html",
    "benchmark:standard": "node benchmarks/run_standard.js",
    "benchmark:steps": "node benchmarks/count_steps.js",
    "benchmark:profile": "node benchmarks/profile.js",
    "benchmark:implementations": "node benchmarks/compare_implementations.js",
    "audit:r7rs": "node scripts/audit_r7rs.js",
    "audit:languages": "node repl.js scripts/language_balance.scm",
    "pin:seed": "node repl.js -I scripts/lib scripts/pin_seed.scm",
    "benchmark:record": "node benchmarks/record_progress.js",
    "benchmark:compiled": "node benchmarks/run_compiled.js",
    "benchmark:profile-compiled": "node benchmarks/profile_compiled.js",
    "benchmark:macro": "node benchmarks/run_macro.js",
    "benchmark:macro-implementations": "node benchmarks/compare_macro.js",
    "benchmark:r7rs": "node benchmarks/run_r7rs.js",
    "benchmark:r7rs-implementations": "node benchmarks/compare_r7rs.js",
    "test:programs": "node tests/programs/run_program_correctness.mjs",
    "benchmark:self-host": "node repl.js --no-compile -I scripts/lib benchmarks/run_self_host.scm",
    "benchmark:hash-tables": "node benchmarks/run_hash_tables.js",
    "benchmark:codegen": "node benchmarks/run_codegen.js",
    "benchmark:tier": "node benchmarks/run_tier.js",
    "benchmark:interop": "node repl.js --no-compile benchmarks/run_interop.scm",
    "benchmark:startup": "node benchmarks/run_startup.js",
    "benchmark:debugger": "node benchmarks/run_debugger.js",
    "benchmark:coverage": "node benchmarks/run_coverage.js"
  },
  "private": true,
  "devDependencies": {
    "rollup": "^4.54.0"
  }
}
